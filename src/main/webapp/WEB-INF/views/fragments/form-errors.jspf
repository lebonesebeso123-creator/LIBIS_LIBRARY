<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:if test="${not empty errors}">
    <div class="alert alert-danger">
        <strong>Please correct the following:</strong>
        <ul class="mb-0">
            <c:forEach var="e" items="${errors}">
                <li><c:out value="${e.value}"/></li>
            </c:forEach>
        </ul>
    </div>
</c:if>
